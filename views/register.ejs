<%- include('partials/header', { pageTitle: 'Register' }) %>
<div class="form-wrapper">
  <div class="card">
    <h2 class="form-title">Create an Applicant Account</h2>
    <% if (locals.errorMessage) { %><div class="alert alert-error"><%= errorMessage %></div><% } %>
    <form action="/register" method="POST">
      <%- include('partials/csrf') %>
      <div class="form-group">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" placeholder="Enter your full name" value="<%= (locals.values && values.name) || '' %>" required maxlength="100">
      </div>
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" placeholder="Enter your email" value="<%= (locals.values && values.email) || '' %>" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Min. 8 characters, letters and numbers" required minlength="8" autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn-primary">Sign Up</button>
    </form>
    <p class="text-center text-muted mt-2">Already have an account? <a href="/login">Log in</a></p>
  </div>
</div>
<%- include('partials/footer') %>
