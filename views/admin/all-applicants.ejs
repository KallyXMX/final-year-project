<%- include('../partials/header', { pageTitle: 'All applicants' }) %>
<div class="page-header"><h1>All Applicants</h1>
  <div class="actions"><a href="/admin/reports/applicants/csv" class="btn btn-secondary btn-sm">Export CSV</a>
  <a href="/admin/reports/applicants/pdf" class="btn btn-secondary btn-sm">Export PDF</a></div></div>

<form class="filter-form" method="GET" action="/admin/applications">
  <div class="form-group"><label for="search">Search name / email</label>
    <input type="text" id="search" name="search" value="<%= query.search || '' %>" placeholder="e.g. Alice"></div>
  <div class="form-group"><label for="status">Status</label>
    <select id="status" name="status"><option value="">All</option>
      <% ['Pending','Shortlisted','Recommended','Accepted','Rejected'].forEach(s => { %>
        <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
  <div class="form-group"><label for="vacancy_id">Vacancy</label>
    <select id="vacancy_id" name="vacancy_id"><option value="">All</option>
      <% vacancies.forEach(v => { %><option value="<%= v.id %>" <%= String(query.vacancy_id) === String(v.id) ? 'selected' : '' %>><%= v.title %></option><% }) %></select></div>
  <div class="actions"><button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a href="/admin/applications" class="btn btn-secondary btn-sm">Clear</a></div>
</form>

<% if (applications.length === 0) { %><div class="empty">No applicants match your filters.</div><% } else { %>
<div class="table-wrap"><table>
  <thead><tr><th>Applicant</th><th>Vacancy</th><th>Applied</th><th>Score</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% applications.forEach(a => { %>
    <tr><td><strong><%= a.applicant_name %></strong><br><span class="text-muted" style="font-size:12px;"><%= a.applicant_email %></span></td>
      <td><%= a.vacancy_title %></td><td><%= fmtDate(a.applied_at) %></td>
      <td><%= a.category === 'academic' ? a.academic_score + ' pts' : (a.percentage !== null ? (+a.percentage).toFixed(1) + '%' : 'N/A') %></td>
      <td><span class="badge status-<%= a.status %>"><%= a.status %></span></td>
      <td><a href="/admin/applications/<%= a.id %>" class="btn btn-secondary btn-sm">View details</a></td></tr>
  <% }) %>
  </tbody></table></div>
<% } %>
<%- include('../partials/footer') %>
