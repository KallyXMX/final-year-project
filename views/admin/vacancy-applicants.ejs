<%- include('../partials/header', { pageTitle: 'Applicants' }) %>
<% const nonAcad = vacancy.category === 'non-academic'; const usesExam = vacancy.usesExam; %>
<div class="page-header">
  <div><h1>Applicants: <%= vacancy.title %></h1>
    <p class="sub"><%= vacancy.department %> &middot; <%= nonAcad ? 'Non-academic' : 'Academic' %> &middot;
      <span class="badge <%= vacancy.state === 'Open' ? 'badge-success' : vacancy.state === 'Upcoming' ? 'badge-warn' : '' %>"><%= vacancy.state %></span>
      &middot; opens <%= fmtDate(vacancy.opens_at) %>, deadline <%= fmtDate(vacancy.deadline) %></p></div>
  <a href="/vacancies">&larr; Back to Vacancies</a>
</div>

<div class="card">
  <div class="actions">
    <% if (vacancy.state !== 'Closed') { %>
      <form action="/admin/vacancies/<%= vacancy.id %>/close" method="POST" onsubmit="return confirm('Close recruitment now? No further applications will be accepted.');">
        <%- include('../partials/csrf') %><button class="btn btn-warning btn-sm btn-auto">Close recruitment now</button></form>
    <% } else if (!vacancy.shortlisted_at && !vacancy.deadline_passed) { %>
      <form action="/admin/vacancies/<%= vacancy.id %>/reopen" method="POST"><%- include('../partials/csrf') %>
        <button class="btn btn-secondary btn-sm btn-auto">Reopen recruitment</button></form>
    <% } %>
    <form action="/admin/vacancies/<%= vacancy.id %>/shortlist" method="POST"><%- include('../partials/csrf') %>
      <button class="btn btn-primary btn-sm btn-auto" <%= (vacancy.state !== 'Closed' || pending === 0) ? 'disabled' : '' %>>Run Auto-Shortlisting (<%= pending %> pending)</button></form>
    <% if (usesExam) { %>
      <a href="/admin/vacancies/<%= vacancy.id %>/exam" class="btn btn-secondary btn-sm">Schedule / configure exam</a>
      <a href="/admin/vacancies/<%= vacancy.id %>/questions" class="btn btn-secondary btn-sm">Question bank (<%= questionCount %>)</a>
    <% } %>
    <a href="/admin/vacancies/<%= vacancy.id %>/settings" class="btn btn-secondary btn-sm">Points &amp; exam settings</a>
    <a href="/admin/reports/applicants/csv?vacancy_id=<%= vacancy.id %>" class="btn btn-secondary btn-sm">Applicants CSV</a>
    <a href="/admin/reports/merit/pdf?vacancy_id=<%= vacancy.id %>" class="btn btn-secondary btn-sm">Merit list PDF</a>
  </div>
  <p class="hint" style="margin-top:10px;">Shortlisting checks each applicant against the vacancy's minimum qualification (<%= vacancy.min_qualification %>) and experience (<%= vacancy.min_experience_years %> yr) and notifies them. It runs automatically once the vacancy closes.
    <% if (usesExam && vacancy.exam_start) { %> Exam: <%= fmtDateTime(vacancy.exam_start) %> &rarr; <%= fmtDateTime(vacancy.exam_end) %> (pass mark <%= vacancy.pass_mark %>%).<% } %></p>
</div>

<% if (applications.length === 0) { %>
  <div class="empty">No applications have been submitted for this vacancy yet.</div>
<% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Applicant</th><th>Qualification</th><th>Exp.</th>
      <% if (!nonAcad) { %><th>Academic pts</th><% } %><% if (usesExam) { %><th>Exam</th><% } %><th>Interview</th><% if (caps) { %><th>Personal data</th><th>Total /100</th><% } %><th>Status</th><th>Decision</th></tr></thead>
    <tbody>
    <% applications.forEach(a => { %>
      <tr>
        <td><strong><%= a.applicant_name %></strong><br><span class="text-muted" style="font-size:12px;"><%= a.applicant_email %></span><br>
          <a href="/admin/applications/<%= a.id %>" style="font-size:12px;">Details &amp; documents</a></td>
        <td><%= a.highest_qualification || '—' %></td>
        <td><%= a.experience_years || 0 %></td>
        <% if (!nonAcad) { %><td><%= capScore(a.academic_score) %></td><% } %>
        <% if (usesExam) { %><td><%= a.percentage !== null ? (+a.percentage).toFixed(1) + '% (' + a.score + '/' + a.total_questions + ')' : 'Not taken' %></td><% } %>
        <td><%= a.interview_score !== null ? a.interview_score : '—' %></td>
        <% if (caps && a.combined) { %><td><%= a.personal_data_score !== null ? a.personal_data_score : '—' %></td><td><strong><%= a.combined.total %></strong></td><% } %>
        <td><span class="badge status-<%= a.status %>"><%= a.status %></span></td>
        <td>
          <% if (!['Accepted'].includes(a.status)) { %>
          <form action="/applications/<%= a.id %>/status" method="POST" class="actions" style="gap:6px;"><%- include('../partials/csrf') %>
            <% if (['Shortlisted','Recommended'].includes(a.status)) { %><button name="status" value="Accepted" class="btn btn-success btn-sm">Accept</button><% } %>
            <% if (a.status !== 'Rejected') { %><button name="status" value="Rejected" class="btn btn-danger btn-sm">Reject</button><% } %>
          </form><% } %>
        </td>
      </tr>
    <% }) %>
    </tbody></table></div>
<% } %>
<%- include('../partials/footer') %>
