<%- include('../partials/header', { pageTitle: 'Audit log' }) %>
<div class="page-header"><div><h1>System Audit Logs</h1><p class="sub"><%= total %> recorded action(s)</p></div>
  <form method="GET" action="/admin/audit-logs" class="actions">
    <select name="action" onchange="this.form.submit()" style="width:auto;">
      <option value="">All actions</option>
      <% actions.forEach(a => { %><option <%= a === action ? 'selected' : '' %>><%= a %></option><% }) %></select></form></div>
<div class="table-wrap"><table>
  <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Description</th><th>IP</th></tr></thead>
  <tbody>
  <% if (logs.length === 0) { %><tr><td colspan="5" style="text-align:center;">No audit logs found.</td></tr><% } %>
  <% logs.forEach(l => { %>
    <tr><td style="white-space:nowrap;"><%= fmtDateTime(l.timestamp) %></td>
      <td><%= l.user_name ? l.user_name : (l.user_id ? 'User #' + l.user_id : 'System') %></td>
      <td><strong><%= l.action %></strong></td><td><%= l.description %></td><td><%= l.ip || '' %></td></tr>
  <% }) %>
  </tbody></table></div>
<div class="pager">
  <% if (page > 1) { %><a href="?page=<%= page - 1 %>&action=<%= encodeURIComponent(action) %>">&larr; Newer</a><% } %>
  <span>Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a href="?page=<%= page + 1 %>&action=<%= encodeURIComponent(action) %>">Older &rarr;</a><% } %>
</div>
<%- include('../partials/footer') %>
