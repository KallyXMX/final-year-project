<%- include('../partials/header', { pageTitle: 'Applicant details' }) %>
<% const academic = application.category === 'academic'; %>
<div class="page-header no-print">
  <div><h1><%= application.applicant_name %></h1>
    <p class="sub"><%= application.vacancy_title %> &middot; <%= application.department %></p></div>
  <div class="actions">
    <a href="/vacancies/<%= application.vacancy_id %>/applications" class="btn btn-secondary btn-sm">&larr; Back</a>
    <button onclick="window.print()" class="btn btn-success btn-sm btn-auto">Print panel summary</button>
  </div>
</div>
<div class="print-only"><h1>Bayero University Kano</h1><h2>Candidate Qualification Summary (Interview Panel)</h2></div>

<div class="grid grid-2">
  <div class="card" style="margin:0">
    <h3 style="margin-bottom:12px;">Applicant</h3>
    <dl class="kv">
      <dt>Name</dt><dd><%= application.applicant_name %></dd>
      <dt>Email</dt><dd><%= application.applicant_email %></dd>
      <dt>Phone</dt><dd><%= application.phone || '—' %></dd>
      <dt>Address</dt><dd><%= application.address || '—' %></dd>
      <dt>Applied</dt><dd><%= fmtDateTime(application.applied_at) %></dd>
      <dt>Status</dt><dd><span class="badge status-<%= application.status %>"><%= application.status %></span>
        <% if (application.status_note) { %><br><small class="text-muted"><%= application.status_note %></small><% } %></dd>
      <dt>Documents</dt><dd>
        <% if (application.cv_path) { %><a href="/applications/<%= application.id %>/documents/cv">CV</a><% } else { %>No CV<% } %> &middot;
        <% if (application.supporting_documents_path) { %><a href="/applications/<%= application.id %>/documents/supporting">Supporting documents</a><% } else { %>No supporting docs<% } %></dd>
    </dl>
  </div>
  <div class="card" style="margin:0">
    <h3 style="margin-bottom:12px;">Vacancy criteria vs applicant</h3>
    <table class="criteria-table">
      <thead><tr><th>Criterion</th><th>Required</th><th>Applicant</th><th>Result</th></tr></thead>
      <tbody>
      <% criteria.forEach(c => { %>
        <tr><td class="label-cell"><%= c.name %></td><td><%= c.required %></td><td><%= c.applicant %></td>
          <td><% if (c.ok) { %><span class="result-ok">&#10003; Meets</span><% } else { %><span class="result-bad">&#10007; <%= c.bad %></span><% } %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card mt-2">
  <h3 style="margin-bottom:12px;">Qualifications, experience<%= academic ? ', publications, seminars & workshops' : '' %></h3>
  <% [['Academic qualifications', lists.qualifications], ['Work experience', lists.experience]].concat(academic ? [['Research publications', lists.publications], ['Seminars & workshops', lists.seminars]] : []).forEach(sec => { %>
    <div class="summary-section">
      <h4><%= sec[0] %> (<%= sec[1].length %>)</h4>
      <% if (sec[1].length === 0) { %><p class="text-muted">None provided by the applicant</p>
      <% } else { %><ul><% sec[1].forEach(i => { %><li><%= i %></li><% }) %></ul><% } %>
    </div>
  <% }) %>
</div>

<% if (academic) { %>
  <div class="card">
    <h3 style="margin-bottom:12px;">Academic evaluation</h3>
    <table>
      <thead><tr><th>Criteria</th><th>Applicant details</th><th class="num">Points</th></tr></thead>
      <tbody>
        <tr><td>Degree qualification <small>(PhD=<%= scheme.phd %>, Masters=<%= scheme.master %>, Bachelor=<%= scheme.bachelor %>)</small></td><td><%= application.highest_qualification || 'N/A' %></td><td class="num"><%= breakdown.degreePoints %></td></tr>
        <tr><td>Teaching experience <small>(<%= scheme.perYearExperience %> pts / year)</small></td><td><%= application.experience_years || 0 %> years</td><td class="num"><%= breakdown.expPoints %></td></tr>
        <tr><td>Journal publications <small>(<%= scheme.perPublication %> pts each)</small></td><td><%= application.journal_publications_count %></td><td class="num"><%= breakdown.pubPoints %></td></tr>
        <tr><td>Seminars &amp; workshops <small>(<%= scheme.perSeminar %> pts each)</small></td><td><%= application.seminars_attended %></td><td class="num"><%= breakdown.semPoints %></td></tr>
        <% if (caps) { %>
          <tr><td colspan="2" style="text-align:right;"><strong>Academic part</strong> <small class="text-muted">(qualification + experience + publications, each capped at its maximum)</small></td><td class="num"><strong><%= combined.academic %> / <%= caps.qualification + caps.experience + caps.publications %></strong></td></tr>
        <% } else { %>
        <tr><td colspan="2" style="text-align:right;"><strong>Total academic score</strong></td><td class="num"><strong><%= capScore(application.academic_score) %> points</strong><% if (breakdown.raw > 100) { %><br><small class="text-muted">(<%= breakdown.raw %> before the cap of 100)</small><% } %></td></tr>
        <% } %>
      </tbody>
    </table>
    <form action="/admin/applications/<%= application.id %>/academic-score" method="POST" class="no-print" style="margin-top:16px;">
      <%- include('../partials/csrf') %>
      <p class="hint mb-1">HR can correct the figures after verifying documents; points are recalculated.</p>
      <div class="form-row">
        <div class="form-group"><label>Highest qualification</label>
          <select name="highest_qualification"><% ['Bachelor','Master','PhD','Other'].forEach(q => { %><option <%= application.highest_qualification === q ? 'selected' : '' %>><%= q %></option><% }) %></select></div>
        <div class="form-group"><label>Teaching years</label><input type="number" name="experience_years" min="0" value="<%= application.experience_years || 0 %>"></div>
        <div class="form-group"><label>Publications</label><input type="number" name="journal_publications_count" min="0" value="<%= application.journal_publications_count %>"></div>
        <div class="form-group"><label>Seminars / workshops</label><input type="number" name="seminars_attended" min="0" value="<%= application.seminars_attended %>"></div>
      </div>
      <button class="btn btn-secondary btn-sm btn-auto">Recalculate score</button>
    </form>
  </div>
<% } %>
<% if (usesExam) { %>
  <div class="card">
    <h3 style="margin-bottom:12px;">Computer-based test</h3>
    <% if (!exam) { %><p class="text-muted">The applicant has not taken the exam.</p><% } else { %>
      <p style="font-size:15px;"><strong><%= exam.score %>/<%= exam.total_questions %></strong> correct &middot; weighted score <strong><%= (+exam.percentage).toFixed(1) %>%</strong>
        <span class="badge <%= exam.passed ? 'badge-success' : 'badge-danger' %>"><%= exam.passed ? 'Passed' : 'Failed' %> (pass mark <%= application.pass_mark %>%)</span></p>
      <table style="margin-top:10px;"><thead><tr><th>Section</th><th class="num">Correct</th><th class="num">%</th><th class="num">Weight</th></tr></thead><tbody>
        <% sectionScores.forEach(s => { %><tr><td><%= s.section %></td><td class="num"><%= s.correct %>/<%= s.total %></td><td class="num"><%= s.percentage %>%</td><td class="num"><%= s.weight %></td></tr><% }) %>
      </tbody></table>
    <% } %>
  </div>
<% } %>

<div class="card">
  <% if (combined) { %>
  <div class="card">
    <h3 style="margin-bottom:12px;">Recruitment score <span class="text-muted" style="font-size:13px;font-weight:400;">(out of 100)</span></h3>
    <table>
      <thead><tr><th>Component</th><th class="num">Maximum</th><th class="num">Score</th></tr></thead>
      <tbody>
        <tr><td>Personal data</td><td class="num"><%= caps.personalData %></td><td class="num"><%= combined.personal !== null ? combined.personal : 'Not recorded' %></td></tr>
        <tr><td>Educational qualification <small>(degree points <%= breakdown.degreePoints %>, capped)</small></td><td class="num"><%= caps.qualification %></td><td class="num"><%= combined.parts.qualification %></td></tr>
        <tr><td>Relevant experience <small>(<%= breakdown.expPoints %> points, capped)</small></td><td class="num"><%= caps.experience %></td><td class="num"><%= combined.parts.experience %></td></tr>
        <tr><td>Publications and seminars <small>(<%= breakdown.pubPoints + breakdown.semPoints %> points, capped)</small></td><td class="num"><%= caps.publications %></td><td class="num"><%= combined.parts.publications %></td></tr>
        <tr><td>Physical interview</td><td class="num"><%= caps.interview %></td><td class="num"><%= combined.interview !== null ? combined.interview : 'Not recorded' %></td></tr>
        <tr><td style="text-align:right;"><strong>Combined total</strong></td><td class="num"><strong><%= caps.personalData + caps.qualification + caps.experience + caps.publications + caps.interview %></strong></td>
          <td class="num"><strong><%= combined.total %><%= combined.complete ? '' : ' (incomplete)' %></strong><% if (!combined.complete) { %><br><small class="text-muted">(personal data and interview scores still missing count as 0; not ranked yet)</small><% } %></td></tr>
      </tbody>
    </table>
  </div>
  <% } %>
  <h3 style="margin-bottom:12px;">Interview evaluation <span class="text-muted" style="font-size:13px;font-weight:400;">(optional &mdash; the interview itself takes place outside the system)</span></h3>
  <% if (application.interview_score !== null) { %>
    <p><strong>Interview score:</strong> <%= application.interview_score %>/<%= caps ? caps.interview : 100 %><% if (caps) { %><br><strong>Personal data score:</strong> <%= application.personal_data_score !== null ? application.personal_data_score + '/' + caps.personalData : 'Not recorded' %><% } %><br><strong>Panel remarks:</strong> <%= application.interviewer_remarks || 'None' %></p>
  <% } else { %><p class="text-muted">No interview result recorded yet.</p><% } %>
  <% if (application.shortlisted && ['Shortlisted','Recommended'].includes(application.status)) { %>
    <form action="/admin/applications/<%= application.id %>/interview" method="POST" class="no-print" style="margin-top:14px;background:#f7fafc;padding:16px;border-radius:8px;">
      <%- include('../partials/csrf') %>
      <div class="form-row">
        <% if (caps) { %>
        <div class="form-group"><label for="personal_data_score">Personal data score (0-<%= caps.personalData %>)</label>
          <input type="number" id="personal_data_score" name="personal_data_score" min="0" max="<%= caps.personalData %>" step="0.01" value="<%= application.personal_data_score ?? '' %>" required></div>
        <% } %>
        <div class="form-group"><label for="interview_score">Interview score (0-<%= caps ? caps.interview : 100 %>)</label>
          <input type="number" id="interview_score" name="interview_score" min="0" max="<%= caps ? caps.interview : 100 %>" step="0.01" value="<%= application.interview_score ?? '' %>" required></div>
        <div class="form-group"><label for="final_decision">Panel decision</label>
          <select id="final_decision" name="final_decision">
            <option value="">Keep current status</option><option value="Recommended">Recommend</option><option value="Rejected">Reject</option></select></div>
      </div>
      <div class="form-group"><label for="interviewer_remarks">Panel remarks</label>
        <textarea id="interviewer_remarks" name="interviewer_remarks" rows="3"><%= application.interviewer_remarks || '' %></textarea></div>
      <button class="btn btn-primary btn-sm btn-auto">Save evaluation</button>
    </form>
  <% } else if (!application.shortlisted) { %>
    <p class="hint">Interview results can be recorded only for shortlisted candidates.</p>
  <% } %>
</div>
<%- include('../partials/footer') %>
