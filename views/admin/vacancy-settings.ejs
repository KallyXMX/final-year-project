<%- include('../partials/header', { pageTitle: 'Vacancy settings' }) %>
<div class="wide-form">
  <div class="page-header"><div><h1>Points &amp; exam settings</h1><p class="sub"><%= vacancy.title %> &middot; <%= vacancy.category === 'academic' ? 'Academic' : 'Non-academic' %></p></div>
    <a href="/vacancies/<%= vacancy.id %>/applications">&larr; Back to applicants</a></div>
  <div class="card">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form action="/admin/vacancies/<%= vacancy.id %>/settings" method="POST">
      <%- include('../partials/csrf') %>
      <%- include('../partials/vacancy-settings-fields', { values, lockExam: locked, showMaxima: vacancy.category === 'academic' }) %>
      <p class="hint mb-2">Saving recalculates every applicant's academic score from the new points and maxima. Changes are recorded in the audit log.</p>
      <button type="submit" class="btn btn-primary">Save settings</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
