<%- include('partials/header', { pageTitle: 'Question bank' }) %>
<div class="page-header"><div><h1>Question bank</h1><p class="sub"><%= vacancy.title %></p></div>
  <div class="actions"><a href="/admin/vacancies/<%= vacancy.id %>/exam" class="btn btn-secondary btn-sm">Schedule exam</a>
  <a href="/vacancies/<%= vacancy.id %>/applications">&larr; Back to applicants</a></div></div>

<% if (vacancy.category !== 'non-academic') { %>
  <div class="alert alert-warn">This is an academic vacancy: no online test is used.</div>
<% } else { %>
<div class="grid grid-2">
  <div class="card" style="margin:0">
    <h3 style="margin-bottom:12px;">Add a question</h3>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form action="/questions/create" method="POST">
      <%- include('partials/csrf') %>
      <input type="hidden" name="vacancy_id" value="<%= vacancy.id %>">
      <div class="form-group"><label for="section">Section</label>
        <select id="section" name="section" required>
          <% ['Aptitude','Computer Literacy'].forEach(s => { %><option <%= values.section === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
      <div class="form-group"><label for="question_text">Question</label><textarea id="question_text" name="question_text" required><%= values.question_text || '' %></textarea></div>
      <% ['a','b','c','d'].forEach(o => { %>
        <div class="form-group"><label>Option <%= o.toUpperCase() %></label><input type="text" name="option_<%= o %>" value="<%= values['option_' + o] || '' %>" required></div>
      <% }) %>
      <div class="form-group"><label for="correct_option">Correct option</label>
        <select id="correct_option" name="correct_option" required><option value="">-- select --</option>
          <% ['A','B','C','D'].forEach(o => { %><option <%= values.correct_option === o ? 'selected' : '' %>><%= o %></option><% }) %></select></div>
      <button class="btn btn-primary">Save question</button>
    </form>
  </div>
  <div>
    <h3 style="margin-bottom:12px;">Existing questions (<%= questions.length %>)</h3>
    <% if (questions.length === 0) { %><div class="empty">No questions yet.</div><% } %>
    <% questions.forEach(q => { %>
      <div class="notice">
        <span class="badge badge-info"><%= q.section %></span> <strong><%= q.question_text %></strong>
        <small>A) <%= q.option_a %> &middot; B) <%= q.option_b %> &middot; C) <%= q.option_c %> &middot; D) <%= q.option_d %> &mdash; correct: <strong><%= q.correct_option %></strong></small>
        <form action="/questions/<%= q.id %>/delete" method="POST" style="margin-top:6px;" onsubmit="return confirm('Delete this question?');">
          <%- include('partials/csrf') %><button class="btn btn-danger btn-sm">Delete</button></form>
      </div>
    <% }) %>
  </div>
</div>
<% } %>
<%- include('partials/footer') %>
