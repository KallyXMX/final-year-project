<%- include('partials/header', { pageTitle: 'My applications' }) %>
<div class="page-header"><h1>My Applications</h1><a href="/vacancies" class="btn btn-secondary btn-sm">Browse vacancies</a></div>

<% if (applications.length === 0) { %>
  <div class="empty">You haven't submitted any applications yet.<br><a href="/vacancies">Explore available vacancies &rarr;</a></div>
<% } else { %>
  <% applications.forEach(a => {
       const nonAcad = a.category === 'non-academic';
       const steps = [];
       steps.push({ t: 'Applied', c: 'done' });
       const decided = a.status !== 'Pending';
       steps.push({ t: 'Shortlisting', c: !decided ? 'current' : (a.shortlisted ? 'done' : 'bad') });
       if (a.shortlisted || !decided) {
         if (nonAcad) steps.push({ t: 'CBT exam', c: a.exam_completed ? 'done' : (a.shortlisted && a.status === 'Shortlisted' ? 'current' : '') });
         else steps.push({ t: 'Qualification evaluation', c: a.shortlisted ? 'done' : '' });
         steps.push({ t: 'Physical interview', c: ['Recommended','Accepted'].includes(a.status) ? 'done' : (a.status === 'Shortlisted' && (a.exam_completed || !nonAcad) ? 'current' : '') });
         steps.push({ t: 'Final decision', c: a.status === 'Accepted' ? 'done' : (a.status === 'Rejected' && a.shortlisted ? 'bad' : '') });
       }
  %>
    <div class="card">
      <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div><h2 style="font-size:18px;"><%= a.job_title %></h2>
          <p class="text-muted" style="font-size:13px;"><%= a.department %> &middot; <%= nonAcad ? 'Non-academic' : 'Academic' %> &middot; applied <%= fmtDate(a.applied_at) %></p></div>
        <div><span class="badge status-<%= a.status %>" style="font-size:13px;"><%= a.status %></span></div>
      </div>
      <ul class="timeline"><% steps.forEach(s => { %><li class="<%= s.c %>"><%= s.t %></li><% }) %></ul>
      <% if (a.status_note) { %><p style="font-size:13px;color:#4a5568;margin-top:8px;"><%= a.status_note %></p><% } %>
      <% if (a.status === 'Pending') { %><p style="font-size:13px;color:#4a5568;margin-top:8px;">Your application is under review. Shortlisting happens automatically after the closing date (<%= fmtDate(a.deadline) %>).</p><% } %>

      <% if (nonAcad && a.shortlisted && a.status === 'Shortlisted' && !a.exam_completed) { %>
        <div class="alert alert-info" style="margin-top:12px;margin-bottom:0;">
          <% if (a.exam_start && a.exam_end) { %>
            Test window: <strong><%= fmtDateTime(a.exam_start) %></strong> to <strong><%= fmtDateTime(a.exam_end) %></strong>.
          <% } else { %>The tests have not been scheduled yet. You will be notified.<% } %>
          <% if (a.canTakeExam) { %><br><a href="/exam/<%= a.vid %>" class="btn btn-primary btn-sm btn-auto" style="margin-top:8px;">Take / continue the test</a>
          <% } else if (a.examNote) { %><br><em><%= a.examNote %></em><% } %>
        </div>
      <% } %>
      <% if (a.exam_completed) { %>
        <p style="margin-top:10px;font-size:14px;">Exam result: <strong><%= a.exam_correct %>/<%= a.exam_total %> (<%= (+a.exam_pct).toFixed(1) %>%)</strong>
          <span class="badge <%= a.exam_passed ? 'badge-success' : 'badge-danger' %>"><%= a.exam_passed ? 'Passed' : 'Below pass mark' %></span>
          <a href="/exam/<%= a.vid %>/result" style="margin-left:8px;">View details</a></p>
      <% } %>
      <p style="margin-top:10px;font-size:13px;">
        <a href="/applications/<%= a.id %>/documents/cv">My CV</a> &middot;
        <a href="/applications/<%= a.id %>/documents/supporting">My supporting documents</a></p>
    </div>
  <% }) %>
<% } %>
<%- include('partials/footer') %>
