<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Applications - BUK Recruitment</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    body {
      background-color: #f0f2f5;
      color: #2d3748;
      padding: 40px 20px;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }

    h1 {
      font-size: 26px;
      color: #1a202c;
    }

    .back-link {
      color: #3182ce;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    .table-container {
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      background-color: #f7fafc;
      padding: 14px 18px;
      font-size: 13px;
      font-weight: 600;
      color: #4a5568;
      text-transform: uppercase;
      border-bottom: 1px solid #e2e8f0;
    }

    td {
      padding: 16px 18px;
      font-size: 14px;
      border-bottom: 1px solid #edf2f7;
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .job-title {
      font-weight: 600;
      color: #2b6cb0;
      font-size: 15px;
    }

    .department {
      color: #718096;
      font-size: 13px;
      margin-top: 2px;
    }

    .status-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
      background-color: #fefcbf;
      color: #744210;
    }

    .btn-exam {
      display: inline-block;
      padding: 8px 16px;
      background-color: #3182ce;
      color: #ffffff;
      text-decoration: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      transition: background-color 0.2s;
    }

    .btn-exam:hover {
      background-color: #2b6cb0;
    }

    .empty-state {
      background: #ffffff;
      padding: 48px;
      text-align: center;
      border-radius: 8px;
      color: #718096;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .empty-state a {
      color: #3182ce;
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>My Applications</h1>
      <a href="/dashboard" class="back-link">&larr; Back to Dashboard</a>
    </header>

    <% if (applications && applications.length > 0) { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Job Title</th>
              <th>Status</th>
              <th>Applied Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% applications.forEach(app => { %>
              <tr>
                <td>
                  <div class="job-title"><%= app.job_title %></div>
                  <% if (app.department) { %>
                    <div class="department"><%= app.department %></div>
                  <% } %>
                </td>
                <td>
                  <span class="status-badge"><%= app.status %></span>
                </td>
                <td>
                  <%= new Date(app.applied_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </td>
                <td>
                  <a href="/exam/<%= app.vacancy_id %>" class="btn-exam">Take Exam</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>You haven't submitted any job applications yet.</p>
        <p style="margin-top: 10px;"><a href="/vacancies">Explore available vacancies &rarr;</a></p>
      </div>
    <% } %>
  </div>
</body>
</html>
