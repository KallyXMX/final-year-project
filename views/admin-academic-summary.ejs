<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Academic Qualification Summary - <%= application.applicant_name %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px auto;
      max-width: 800px;
      color: #333;
    }
    .header {
      text-align: center;
      border-bottom: 2px solid #2b6cb0;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }
    .header h1 {
      margin: 0 0 10px 0;
      color: #2b6cb0;
    }
    .header h2 {
      margin: 0;
      color: #555;
      font-size: 18px;
    }
    .candidate-info {
      margin-bottom: 30px;
      padding: 15px;
      background: #f7fafc;
      border: 1px solid #e2e8f0;
    }
    .candidate-info p {
      margin: 5px 0;
      font-size: 16px;
    }
    .candidate-info strong {
      display: inline-block;
      width: 150px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
    }
    th, td {
      border: 1px solid #cbd5e0;
      padding: 12px;
      text-align: left;
    }
    th {
      background-color: #edf2f7;
      color: #4a5568;
    }
    .total-row {
      font-weight: bold;
      background-color: #ebf8ff;
    }
    .total-score {
      font-size: 20px;
      color: #2b6cb0;
    }
    @media print {
      body {
        margin: 0;
        padding: 20px;
      }
      .no-print {
        display: none;
      }
    }
    .btn {
      display: inline-block;
      padding: 10px 20px;
      background-color: #2b6cb0;
      color: white;
      text-decoration: none;
      border-radius: 4px;
      margin-right: 10px;
    }
  </style>
</head>
<body>

  <div class="no-print" style="margin-bottom: 20px;">
    <a href="/vacancies/<%= application.vacancy_id %>/applications" class="btn">&larr; Back</a>
    <button onclick="window.print()" class="btn" style="background-color: #38a169; border:none; cursor:pointer;">Print Summary</button>
  </div>

  <div class="header">
    <h1>Bayero University Kano</h1>
    <h2>Academic Qualification Summary (Interview Panel)</h2>
  </div>

  <div class="candidate-info">
    <p><strong>Applicant Name:</strong> <%= application.applicant_name %></p>
    <p><strong>Department:</strong> <%= application.department %></p>
    <p><strong>Vacancy Applied:</strong> <%= application.vacancy_title %></p>
    <p><strong>Application Date:</strong> <%= new Date(application.applied_at).toLocaleDateString() %></p>
    <div style="margin-top: 15px;">
      <strong>Uploaded Documents:</strong>
      <ul style="margin-top: 5px; list-style-type: none; padding: 0;">
        <% if (application.cv_path) { %>
          <li><a href="<%= application.cv_path %>" target="_blank" style="color: #2b6cb0;">📄 View CV</a></li>
        <% } %>
        <% if (application.supporting_documents_path) { %>
          <li><a href="<%= application.supporting_documents_path %>" target="_blank" style="color: #2b6cb0;">📄 View Supporting Documents</a></li>
        <% } %>
        <% if (!application.cv_path && !application.supporting_documents_path) { %>
          <li>No documents uploaded.</li>
        <% } %>
      </ul>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Evaluation Criteria</th>
        <th>Applicant Details</th>
        <th>Points Awarded</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Degree Qualification<br><small>(PhD=40, Masters=25, BSc=10)</small></td>
        <td><%= application.highest_qualification || 'N/A' %></td>
        <td><%= breakdown.degreePoints %></td>
      </tr>
      <tr>
        <td>Teaching Experience<br><small>(5 pts / year)</small></td>
        <td><%= application.teaching_experience_years || 0 %> Years</td>
        <td><%= breakdown.expPoints %></td>
      </tr>
      <tr>
        <td>Publications & Seminars<br><small>(Journal=4 pts, Seminar=2 pts)</small></td>
        <td>
          Journals: <%= application.journal_publications_count || 0 %><br>
          Seminars: <%= application.seminars_attended || 0 %>
        </td>
        <td><%= breakdown.pubPoints %></td>
      </tr>
      <tr class="total-row">
        <td colspan="2" style="text-align: right;">Total Academic Score:</td>
        <td class="total-score"><%= application.academic_score || 0 %> Points</td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 50px;">
    <% if (application.status === 'Shortlisted') { %>
      <div class="no-print">
        <h3>Physical Interview Evaluation</h3>
        <form action="/admin/applications/<%= application.id %>/interview" method="POST" style="background: #f7fafc; padding: 20px; border: 1px solid #e2e8f0; border-radius: 8px;">
          <div style="margin-bottom: 15px;">
            <label for="interview_score" style="display:block; margin-bottom: 5px; font-weight:bold;">Interview Score (0-100):</label>
            <input type="number" id="interview_score" name="interview_score" min="0" max="100" value="<%= application.interview_score || '' %>" style="padding: 8px; width: 100%; max-width: 200px;" required>
          </div>
          <div style="margin-bottom: 15px;">
            <label for="interviewer_remarks" style="display:block; margin-bottom: 5px; font-weight:bold;">Panel Remarks:</label>
            <textarea id="interviewer_remarks" name="interviewer_remarks" rows="4" style="padding: 8px; width: 100%;" required><%= application.interviewer_remarks || '' %></textarea>
          </div>
          <div style="margin-bottom: 15px;">
            <label for="final_decision" style="display:block; margin-bottom: 5px; font-weight:bold;">Final Decision:</label>
            <select id="final_decision" name="final_decision" style="padding: 8px; width: 100%; max-width: 200px;">
              <option value="Shortlisted" <%= application.status === 'Shortlisted' ? 'selected' : '' %>>Pending Final Decision</option>
              <option value="Recommended">Recommend</option>
              <option value="Rejected">Reject</option>
            </select>
          </div>
          <button type="submit" class="btn" style="margin:0;">Save Evaluation</button>
        </form>
      </div>
    <% } %>

    <div style="margin-top: 30px;">
      <h3>Recorded Interview Details</h3>
      <p><strong>Score:</strong> <%= application.interview_score !== null ? application.interview_score : 'Not evaluated yet' %></p>
      <p><strong>Remarks:</strong> <%= application.interviewer_remarks || 'None' %></p>
      <p><strong>Status:</strong> <%= application.status %></p>
    </div>
  </div>

</body>
</html>
