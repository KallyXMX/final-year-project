<%# Points scheme, category maxima, positions + exam switches. Expects: values; optionally lockExam (true once applicants started the exam) and showMaxima (false for non-academic vacancies). %>
<% const locked = typeof lockExam !== 'undefined' && lockExam; const withMaxima = typeof showMaxima === 'undefined' || showMaxima; %>
<input type="hidden" name="settings_form" value="1">
<fieldset><legend>Academic points scheme (score is capped at 100)</legend>
  <div class="form-row">
    <div class="form-group"><label for="pts_phd">PhD</label><input type="number" id="pts_phd" name="pts_phd" min="0" max="100" step="1" value="<%= values.pts_phd ?? 40 %>" required></div>
    <div class="form-group"><label for="pts_master">Master's</label><input type="number" id="pts_master" name="pts_master" min="0" max="100" step="1" value="<%= values.pts_master ?? 25 %>" required></div>
    <div class="form-group"><label for="pts_bachelor">Bachelor's</label><input type="number" id="pts_bachelor" name="pts_bachelor" min="0" max="100" step="1" value="<%= values.pts_bachelor ?? 10 %>" required></div>
  </div>
  <div class="form-row">
    <div class="form-group"><label for="pts_per_year">Per year of experience</label><input type="number" id="pts_per_year" name="pts_per_year" min="0" max="100" step="1" value="<%= values.pts_per_year ?? 5 %>" required></div>
    <div class="form-group"><label for="pts_per_publication">Per publication</label><input type="number" id="pts_per_publication" name="pts_per_publication" min="0" max="100" step="1" value="<%= values.pts_per_publication ?? 4 %>" required></div>
    <div class="form-group"><label for="pts_per_seminar">Per seminar</label><input type="number" id="pts_per_seminar" name="pts_per_seminar" min="0" max="100" step="1" value="<%= values.pts_per_seminar ?? 2 %>" required></div>
  </div>
  <p class="hint">Whole numbers from 0 to 100. Used for academic vacancies; applicants see this scheme on the vacancy.</p>
</fieldset>
<% if (withMaxima) { %>
<fieldset><legend>Recruitment score: maximum points per category (academic vacancies)</legend>
  <div class="form-row">
    <div class="form-group"><label for="max_personal_data">Personal data</label><input type="number" id="max_personal_data" name="max_personal_data" min="0" max="100" step="1" value="<%= values.max_personal_data ?? '' %>"></div>
    <div class="form-group"><label for="max_qualification">Educational qualification</label><input type="number" id="max_qualification" name="max_qualification" min="0" max="100" step="1" value="<%= values.max_qualification ?? '' %>"></div>
    <div class="form-group"><label for="max_experience">Relevant experience</label><input type="number" id="max_experience" name="max_experience" min="0" max="100" step="1" value="<%= values.max_experience ?? '' %>"></div>
    <div class="form-group"><label for="max_publications">Publications</label><input type="number" id="max_publications" name="max_publications" min="0" max="100" step="1" value="<%= values.max_publications ?? '' %>"></div>
    <div class="form-group"><label for="max_interview">Physical interview</label><input type="number" id="max_interview" name="max_interview" min="0" max="100" step="1" value="<%= values.max_interview ?? '' %>"></div>
  </div>
  <p class="hint">Whole numbers; the five must add up to exactly 100. The qualification, experience and publications parts of the academic score are each capped at their maximum (publications and seminars share one cap); the personal data and interview scores are entered by HR. Leave all five empty to keep the old scoring (one academic score capped at 100, no combined total).</p>
</fieldset>
<% } %>
<fieldset><legend>Number of positions (optional)</legend>
  <div class="form-group"><label for="slots">Positions to fill</label><input type="number" id="slots" name="slots" min="1" max="1000" step="1" value="<%= values.slots ?? '' %>" style="max-width:160px;"></div>
  <p class="hint">Optional. The merit list marks that many top-ranked applicants "Within slots". It is only a marker; HR still records every decision.</p>
</fieldset>
<fieldset><legend>Online exam</legend>
  <% if (locked) { %><p class="hint">Applicants have already started the exam, so these switches are locked.</p><% } %>
  <label style="display:block;margin-bottom:8px;"><input type="checkbox" name="academic_exam_enabled" value="1" <%= Number(values.academic_exam_enabled) === 1 ? 'checked' : '' %> <%= locked ? 'disabled' : '' %>>
    Enable the online exam for this vacancy <span class="text-muted">(academic vacancies only; non-academic vacancies always have the exam)</span></label>
  <label style="display:block;margin-bottom:8px;"><input type="checkbox" name="aptitude_enabled" value="1" <%= values.aptitude_enabled === 0 || values.aptitude_enabled === '0' ? '' : 'checked' %> <%= locked ? 'disabled' : '' %>> Aptitude section on</label>
  <label style="display:block;margin-bottom:8px;"><input type="checkbox" name="literacy_enabled" value="1" <%= values.literacy_enabled === 0 || values.literacy_enabled === '0' ? '' : 'checked' %> <%= locked ? 'disabled' : '' %>> Computer Literacy section on</label>
  <p class="hint">At least one section must stay on. With one section on, it counts at full weight.</p>
</fieldset>
