<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.pageTitle ? pageTitle + ' - ' : '' %>BUK Recruitment Portal</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="navbar-brand">BUK Recruitment Portal</a>
    <div class="navbar-links">
      <% if (locals.currentUser) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/vacancies">Vacancies</a>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin/applications">Applicants</a>
          <a href="/admin/reports">Reports</a>
          <a href="/admin/audit-logs">Audit Log</a>
          <a href="/admin/sessions">Sessions</a>
        <% } else { %>
          <a href="/my-applications">My Applications</a>
          <a href="/notifications">Notifications<% if (unreadCount > 0) { %><span class="nav-badge"><%= unreadCount %></span><% } %></a>
        <% } %>
        <a href="/logout" class="btn-nav-logout">Logout</a>
      <% } else { %>
        <a href="/vacancies">Vacancies</a>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
      <% } %>
    </div>
  </nav>
  <main class="page-wrapper">
  <% if (locals.flash) { %>
    <div class="alert alert-<%= flash.type %>" role="status"><%= flash.text %></div>
  <% } %>
