<%- include('partials/header', { pageTitle: 'Online test' }) %>
<div class="exam-timer" id="timerDisplay" data-seconds="<%= view.remainingSeconds %>">Time remaining: --:--</div>
<div class="wide-form" style="margin-top:16px;">
  <div class="page-header">
    <div><h1><%= view.name %></h1>
      <p class="sub"><%= vacancy.title %> &middot; section <%= view.index + 1 %> of <%= view.total %> &middot; <%= view.minutes %> minutes</p></div>
  </div>
  <form id="examForm" action="/exam/<%= vacancy.id %>/submit" method="POST">
    <%- include('partials/csrf') %>
    <input type="hidden" name="section_index" value="<%= view.index %>">
    <% view.questions.forEach((q, i) => { %>
      <div class="question-card">
        <div class="question-title"><%= i + 1 %>. <%= q.question_text %></div>
        <% ['a','b','c','d'].forEach(o => { %>
          <label class="option-label">
            <input type="radio" name="q_<%= q.id %>" value="<%= o.toUpperCase() %>" <%= view.answers[q.id] === o.toUpperCase() ? 'checked' : '' %>>
            <span><strong><%= o.toUpperCase() %>.</strong> <%= q['option_' + o] %></span>
          </label>
        <% }) %>
      </div>
    <% }) %>
    <button type="submit" class="btn btn-primary" id="submitBtn"
      onclick="return confirm('Submit this section? You cannot return to it.');">
      <%= view.index + 1 < view.total ? 'Submit section and continue' : 'Submit test' %></button>
  </form>
</div>
<script>
  (function () {
    var el = document.getElementById('timerDisplay');
    var form = document.getElementById('examForm');
    var end = Date.now() + Number(el.getAttribute('data-seconds')) * 1000; // server-supplied remaining time
    var submitted = false;
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      var left = Math.max(0, Math.round((end - Date.now()) / 1000));
      el.textContent = 'Time remaining: ' + pad(Math.floor(left / 60)) + ':' + pad(left % 60);
      if (left <= 60) el.classList.add('low');
      if (left <= 0 && !submitted) {
        submitted = true;
        form.submit(); // auto-submit when the section time is up
      }
    }
    form.addEventListener('submit', function () { submitted = true; });
    tick();
    setInterval(tick, 1000);
  })();
</script>
<%- include('partials/footer') %>
