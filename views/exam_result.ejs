<%- include('partials/header', { pageTitle: 'Test result' }) %>
<div class="wide-form">
  <div class="page-header"><div><h1>Test result</h1><p class="sub"><%= vacancy.title %></p></div>
    <a href="/my-applications">&larr; My applications</a></div>
  <div class="card text-center">
    <div class="score-big"><%= (+result.percentage).toFixed(1) %>%</div>
    <p class="text-muted"><%= result.score %> of <%= result.total_questions %> questions correct (weighted score)</p>
    <p style="margin-top:10px;"><span class="badge <%= result.passed ? 'badge-success' : 'badge-danger' %>" style="font-size:14px;">
      <%= result.passed ? 'Passed' : 'Below pass mark' %></span> <span class="text-muted">Pass mark: <%= passMark %>%</span></p>
  </div>
  <% if (sections.length) { %>
  <div class="card">
    <h2 style="font-size:16px;margin-bottom:10px;">Section breakdown</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Section</th><th>Correct</th><th>Score</th><th>Weight</th></tr></thead>
      <tbody><% sections.forEach(s => { %>
        <tr><td><%= s.section %></td><td><%= s.correct %> / <%= s.total %></td><td><%= (+s.percentage).toFixed(1) %>%</td><td><%= s.weight %></td></tr>
      <% }) %></tbody>
    </table></div>
  </div>
  <% } %>
  <p class="text-muted" style="font-size:13px;">Submitted <%= fmtDateTime(result.submitted_at) %>. HR will contact shortlisted candidates about the physical interview.</p>
</div>
<%- include('partials/footer') %>
