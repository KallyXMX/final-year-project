<%- include('partials/header', { pageTitle: 'Post vacancy' }) %>
<div class="wide-form">
  <div class="page-header"><h1>Post New Vacancy</h1><a href="/vacancies">&larr; Back to Vacancies</a></div>
  <div class="card">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form action="/vacancies/create" method="POST">
      <%- include('partials/csrf') %>
      <div class="form-row">
        <div class="form-group"><label for="title">Position title</label>
          <input type="text" id="title" name="title" value="<%= values.title || '' %>" placeholder="e.g. Lecturer II" required maxlength="150"></div>
        <div class="form-group"><label for="department">Department</label>
          <input type="text" id="department" name="department" value="<%= values.department || '' %>" placeholder="e.g. Computer Science" required maxlength="150"></div>
      </div>
      <div class="form-group"><label for="category">Recruitment type</label>
        <select id="category" name="category">
          <option value="non-academic" <%= values.category !== 'academic' ? 'selected' : '' %>>Non-academic (aptitude + computer literacy tests)</option>
          <option value="academic" <%= values.category === 'academic' ? 'selected' : '' %>>Academic (qualification points, no online test)</option>
        </select>
        <p class="hint">Academic and non-academic vacancies follow different workflows after shortlisting.</p></div>
      <div class="form-group"><label for="description">Job description</label>
        <textarea id="description" name="description" required><%= values.description || '' %></textarea></div>
      <div class="form-group"><label for="requirements">Application requirements (shown to applicants)</label>
        <textarea id="requirements" name="requirements" required><%= values.requirements || '' %></textarea></div>
      <fieldset><legend>Minimum criteria used for automatic shortlisting</legend>
        <div class="form-row">
          <div class="form-group"><label for="min_qualification">Minimum qualification</label>
            <select id="min_qualification" name="min_qualification">
              <% [['None','No minimum'],['Bachelor',"Bachelor's / HND"],['Master',"Master's degree"],['PhD','PhD / Doctorate']].forEach(o => { %>
                <option value="<%= o[0] %>" <%= values.min_qualification === o[0] ? 'selected' : '' %>><%= o[1] %></option>
              <% }) %>
            </select></div>
          <div class="form-group"><label for="min_experience_years">Minimum experience (years)</label>
            <input type="number" id="min_experience_years" name="min_experience_years" min="0" max="60" value="<%= values.min_experience_years ?? 0 %>"></div>
        </div>
      </fieldset>
      <div class="form-row">
        <div class="form-group"><label for="opens_at">Applications open on</label>
          <input type="date" id="opens_at" name="opens_at" value="<%= values.opens_at || '' %>" required></div>
        <div class="form-group"><label for="deadline">Application deadline</label>
          <input type="date" id="deadline" name="deadline" value="<%= values.deadline || '' %>" required></div>
      </div>
      <p class="hint mb-2">Recruitment opens and closes automatically on these dates. Auto-shortlisting runs after the deadline.</p>
      <button type="submit" class="btn btn-primary">Publish Vacancy</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
