<%- include('partials/header', { pageTitle: 'Vacancies' }) %>
<% const me = locals.currentUser; const isAdmin = me && me.role === 'admin'; %>
<div class="page-header">
  <div><h1><%= isAdmin ? 'Manage Vacancies' : 'Available Vacancies' %></h1>
    <p class="sub">Staff recruitment at Bayero University Kano</p></div>
  <% if (isAdmin) { %><a href="/vacancies/create" class="btn btn-primary btn-auto">+ Post New Vacancy</a><% } %>
</div>

<% if (vacancies.length === 0) { %>
  <div class="empty">No vacancies are currently available. Please check back later.</div>
<% } else { %>
  <div class="grid">
  <% vacancies.forEach(job => { %>
    <div class="card" style="border-left:4px solid <%= job.state === 'Open' ? '#38a169' : job.state === 'Upcoming' ? '#d69e2e' : '#a0aec0' %>;margin:0">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:10px;">
        <div>
          <h2 style="font-size:19px;color:#2b6cb0;margin-bottom:6px;"><%= job.title %></h2>
          <span class="badge badge-info"><%= job.department %></span>
          <span class="badge badge-purple"><%= job.category === 'academic' ? 'Academic' : 'Non-academic' %></span>
          <span class="badge <%= job.state === 'Open' ? 'badge-success' : job.state === 'Upcoming' ? 'badge-warn' : '' %>"><%= job.state %></span>
        </div>
        <span class="text-muted" style="font-size:13px;text-align:right;">
          Opens: <strong><%= fmtDate(job.opens_at) %></strong><br>Deadline: <strong><%= fmtDate(job.deadline) %></strong></span>
      </div>
      <p style="margin-top:14px;font-size:14px;line-height:1.6;white-space:pre-line;"><strong>Description:</strong> <%= job.description %></p>
      <p style="margin-top:8px;font-size:14px;line-height:1.6;white-space:pre-line;"><strong>Requirements:</strong> <%= job.requirements %></p>
      <p style="margin-top:8px;font-size:13px;color:#4a5568;">Minimum: <strong><%= job.min_qualification === 'None' ? 'No minimum qualification' : job.min_qualification %></strong>
        <% if (job.min_qualification !== 'None') { %> degree level<% } %> &middot; <strong><%= job.min_experience_years %></strong> year(s) experience</p>

      <div class="actions" style="margin-top:16px;">
        <% if (isAdmin) { %>
          <span class="text-muted" style="font-size:13px;"><%= job.application_count %> application(s)</span>
          <a href="/vacancies/<%= job.id %>/applications" class="btn btn-secondary btn-sm">View Applications</a>
          <% if (job.category === 'non-academic') { %>
            <a href="/admin/vacancies/<%= job.id %>/questions" class="btn btn-secondary btn-sm">Question Bank</a>
          <% } %>
        <% } else if (!me) { %>
          <% if (job.state === 'Open') { %><a href="/login" class="btn btn-primary btn-sm">Log in to apply</a><% } %>
        <% } else if (myApps[job.id]) { %>
          <span class="badge status-<%= myApps[job.id] %>">Applied &middot; <%= myApps[job.id] %></span>
          <a href="/my-applications" class="btn btn-secondary btn-sm">Track application</a>
        <% } else if (job.state === 'Open') { %>
          <a href="/vacancies/<%= job.id %>/apply" class="btn btn-success btn-sm">Apply Now</a>
        <% } else { %>
          <button class="btn btn-secondary btn-sm" disabled><%= job.state === 'Upcoming' ? 'Not open yet' : 'Closed' %></button>
        <% } %>
      </div>
    </div>
  <% }) %>
  </div>
<% } %>
<%- include('partials/footer') %>
