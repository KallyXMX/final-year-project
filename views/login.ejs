<%- include('partials/header', { pageTitle: 'Log in' }) %>
<div class="form-wrapper">
  <div class="card">
    <h2 class="form-title">Log In</h2>
    <% if (locals.errorMessage) { %><div class="alert alert-error"><%= errorMessage %></div><% } %>
    <form action="/login" method="POST">
      <%- include('partials/csrf') %>
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" placeholder="Enter your email" value="<%= (locals.values && values.email) || '' %>" required autocomplete="username">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary">Log In</button>
    </form>
    <p class="text-center text-muted mt-2">Don't have an account? <a href="/register">Sign up</a></p>
  </div>
</div>
<%- include('partials/footer') %>
