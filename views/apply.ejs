<%- include('partials/header', { pageTitle: 'Apply' }) %>
<% const academic = vacancy.category === 'academic'; %>
<div class="wide-form">
  <div class="page-header"><div><h1>Apply: <%= vacancy.title %></h1>
    <p class="sub"><%= vacancy.department %> &middot; closes <%= fmtDate(vacancy.deadline) %></p></div>
    <a href="/vacancies">&larr; Back to Vacancies</a></div>
  <div class="card">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <p class="text-muted mb-2" style="font-size:14px;"><strong>Requirements:</strong> <%= vacancy.requirements %></p>
    <% if (academic) { %><%- include('partials/points-scheme', { job: vacancy }) %><div class="mb-2"></div><% } %>
    <form action="/vacancies/<%= vacancy.id %>/apply?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
      <fieldset><legend>Contact details</legend>
        <div class="form-row">
          <div class="form-group"><label for="phone">Phone number</label>
            <input type="text" id="phone" name="phone" value="<%= values.phone || '' %>" placeholder="+234 801 234 5678" required></div>
          <div class="form-group"><label for="address">Contact address</label>
            <input type="text" id="address" name="address" value="<%= values.address || '' %>" required maxlength="300"></div>
        </div>
      </fieldset>
      <fieldset><legend>Qualifications &amp; experience</legend>
        <div class="form-row">
          <div class="form-group"><label for="highest_qualification">Highest qualification</label>
            <select id="highest_qualification" name="highest_qualification" required>
              <option value="">-- select --</option>
              <% [['Bachelor',"Bachelor's Degree / HND"],['Master',"Master's Degree"],['PhD','PhD / Doctorate'],['Other','Other / below degree']].forEach(o => { %>
                <option value="<%= o[0] %>" <%= values.highest_qualification === o[0] ? 'selected' : '' %>><%= o[1] %></option>
              <% }) %>
            </select></div>
          <div class="form-group"><label for="experience_years"><%= academic ? 'Teaching experience (years)' : 'Relevant work experience (years)' %></label>
            <input type="number" id="experience_years" name="experience_years" min="0" max="60" value="<%= values.experience_years ?? 0 %>" required></div>
        </div>
        <%- include('partials/multi-entry', { field: 'qualifications_text', label: 'Academic qualifications', placeholder: 'e.g. B.Sc. Computer Science, BUK, 2015', required: true, text: values.qualifications_text }) %>
        <%- include('partials/multi-entry', { field: 'experience_text', label: 'Work experience', placeholder: 'e.g. Systems Officer, ABC Ltd, 2016 - 2021', required: false, text: values.experience_text }) %>
        <% if (academic) { %>
          <%- include('partials/multi-entry', { field: 'publications_text', label: 'Research publications (journals, conference papers)', placeholder: 'One publication per box.', required: false, text: values.publications_text }) %>
          <%- include('partials/multi-entry', { field: 'seminars_text', label: 'Professional achievements: workshops & seminars', placeholder: 'One workshop or seminar per box.', required: false, text: values.seminars_text }) %>
        <% } %>
      </fieldset>
      <fieldset><legend>Documents (PDF, DOC or DOCX, max 5MB each)</legend>
        <div class="form-group"><label for="cv">Curriculum Vitae (CV)</label>
          <input type="file" id="cv" name="cv" accept=".pdf,.doc,.docx" required></div>
        <div class="form-group"><label for="supporting_docs">Supporting documents (certificates etc.)</label>
          <input type="file" id="supporting_docs" name="supporting_docs" accept=".pdf,.doc,.docx" required></div>
      </fieldset>
      <button type="submit" class="btn btn-success">Submit Application</button>
    </form>
  </div>
</div>
<script>
  (function () {
    document.querySelectorAll('.multi').forEach(function (box) {
      var list = box.querySelector('.multi-list'), add = box.querySelector('.multi-add');
      var max = Number(box.dataset.max), field = box.dataset.field, ph = box.dataset.placeholder;
      var required = list.querySelector('input').hasAttribute('required');
      function sync() {
        var n = list.children.length;
        add.disabled = n >= max;
        list.querySelectorAll('.multi-remove').forEach(function (b) { b.style.visibility = n > 1 ? 'visible' : 'hidden'; });
      }
      add.addEventListener('click', function () {
        if (list.children.length >= max) return;
        var row = document.createElement('div'); row.className = 'multi-row';
        var inp = document.createElement('input'); inp.type = 'text'; inp.name = field + '[]'; inp.placeholder = ph; inp.maxLength = 300;
        var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'multi-remove'; rm.title = 'Remove'; rm.setAttribute('aria-label', 'Remove entry'); rm.innerHTML = '&times;';
        row.appendChild(inp); row.appendChild(rm); list.appendChild(row); inp.focus(); sync();
      });
      list.addEventListener('click', function (e) {
        if (!e.target.classList.contains('multi-remove') || list.children.length <= 1) return;
        e.target.parentNode.remove();
        if (required && !list.querySelector('input[required]')) list.querySelector('input').setAttribute('required', '');
        sync();
      });
      sync();
    });
  })();
</script>
<%- include('partials/footer') %>
