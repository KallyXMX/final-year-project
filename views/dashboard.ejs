<%- include('partials/header', { user: { userId: user.id } }) %>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

<div class="card mb-3">
  <h1 style="font-size:26px; color:#1a202c; margin-bottom:6px;">Welcome, <%= user.name %>!</h1>
  <p class="text-muted">Logged in as: <strong><%= user.email %></strong>
    &nbsp;<span class="badge badge-info" style="text-transform:uppercase;"><%= user.role %></span>
  </p>
</div>

<% if (user.role === 'admin' && typeof analytics !== 'undefined' && analytics) { %>
  <h2 style="font-size:18px; margin-bottom:16px; color:#2d3748;">System Overview</h2>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:20px; margin-bottom: 24px;">
    <div class="card" style="border-left: 4px solid #4299e1; padding: 16px;">
      <h3 style="font-size:14px; color:#718096; margin-bottom:4px; text-transform: uppercase;">Total Users</h3>
      <p style="font-size:28px; font-weight:bold; color:#2d3748; margin:0;"><%= analytics.totalUsers %></p>
    </div>
    <div class="card" style="border-left: 4px solid #48bb78; padding: 16px;">
      <h3 style="font-size:14px; color:#718096; margin-bottom:4px; text-transform: uppercase;">Active Jobs</h3>
      <p style="font-size:28px; font-weight:bold; color:#2d3748; margin:0;"><%= analytics.totalVacancies %></p>
    </div>
    <div class="card" style="border-left: 4px solid #ecc94b; padding: 16px;">
      <h3 style="font-size:14px; color:#718096; margin-bottom:4px; text-transform: uppercase;">Total Apps</h3>
      <p style="font-size:28px; font-weight:bold; color:#2d3748; margin:0;"><%= analytics.totalApplications %></p>
    </div>
    <div class="card" style="border-left: 4px solid #9f7aea; padding: 16px;">
      <h3 style="font-size:14px; color:#718096; margin-bottom:4px; text-transform: uppercase;">Average Score</h3>
      <p style="font-size:28px; font-weight:bold; color:#2d3748; margin:0;"><%= analytics.averageScore %></p>
    </div>
  </div>

  <!-- Application Status Chart -->
  <div class="card" style="margin-bottom: 24px; padding: 20px;">
    <h3 style="font-size:15px; color:#4a5568; text-transform:uppercase; margin-bottom:16px; letter-spacing:0.05em;">Application Status Distribution</h3>
    <div style="max-width: 340px; margin: 0 auto;">
      <canvas id="recruitmentChart" aria-label="Application status doughnut chart" role="img"></canvas>
    </div>
  </div>

  <script>
    (function () {
      const counts = <%- JSON.stringify(analytics.statusCounts) %>;
      const ctx = document.getElementById('recruitmentChart').getContext('2d');
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: Object.keys(counts),
          datasets: [{
            data: Object.values(counts),
            backgroundColor: ['#ecc94b','#4299e1','#9f7aea','#fc8181','#68d391'],
            borderColor:     ['#d69e2e','#2b6cb0','#6b46c1','#e53e3e','#38a169'],
            borderWidth: 2,
            hoverOffset: 8
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { position: 'bottom', labels: { padding: 16, font: { size: 13 } } },
            tooltip: {
              callbacks: {
                label: function(ctx) {
                  const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                  const pct   = total ? ((ctx.parsed / total) * 100).toFixed(1) : 0;
                  return ` ${ctx.label}: ${ctx.parsed} (${pct}%)`;
                }
              }
            }
          }
        }
      });
    })();
  </script>

<% } %>

<h2 style="font-size:18px; margin-bottom:16px; color:#2d3748;">Dashboard Actions</h2>

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(270px,1fr)); gap:20px;">
  <% if (user.role === 'admin') { %>
    <div class="card" style="border-top: 4px solid #2b6cb0;">
      <h3 style="font-size:17px; margin-bottom:8px;">Post a New Vacancy</h3>
      <p class="text-muted mb-2" style="font-size:14px;">Create and publish new employment vacancies for prospective applicants.</p>
      <a href="/vacancies/create" class="btn btn-primary">Post a New Vacancy</a>
    </div>

    <div class="card" style="border-top: 4px solid #2b6cb0;">
      <h3 style="font-size:17px; margin-bottom:8px;">Manage Exam Questions</h3>
      <p class="text-muted mb-2" style="font-size:14px;">Configure examination questions for active recruitment vacancies.</p>
      <a href="/questions/create" class="btn btn-primary">Manage Exam Questions</a>
    </div>

    <div class="card" style="border-top: 4px solid #2b6cb0;">
      <h3 style="font-size:17px; margin-bottom:8px;">View All Vacancies</h3>
      <p class="text-muted mb-2" style="font-size:14px;">Browse and manage all active job vacancies and review applicants.</p>
      <a href="/vacancies" class="btn btn-primary">View All Vacancies</a>
    </div>

    <div class="card" style="border-top: 4px solid #805ad5;">
      <h3 style="font-size:17px; margin-bottom:8px;">HR Reports & Exports</h3>
      <p class="text-muted mb-2" style="font-size:14px;">Download comprehensive recruitment metrics and passed applicant lists.</p>
      <div style="display:flex; flex-direction:column; gap:8px;">
        <a href="/admin/reports/pdf" class="btn btn-primary" style="background-color:#553c9a; border:none;">Download PDF Merit List</a>
        <a href="/admin/reports/csv" class="btn btn-secondary" style="background-color:#e9d8fd; color:#44337a; border:none; text-align:center; padding:10px; border-radius:4px; text-decoration:none; font-weight:bold;">Download CSV Report</a>
      </div>
    </div>
  <% } else { %>
    <% if (locals.error) { %>
      <div class="alert alert-danger" style="background-color: #fed7d7; color: #742a2a; padding: 12px; border-radius: 4px; margin-bottom: 20px; width: 100%;"><%= error %></div>
    <% } %>

    <% const shortlistedApps = myApplications ? myApplications.filter(a => a.status === 'Shortlisted' && a.exam_completed === 0) : []; %>
    <% if (shortlistedApps.length > 0) { %>
      <div style="grid-column: 1 / -1; background-color: #ebf8ff; color: #2b6cb0; padding: 15px; border-radius: 5px; border-left: 4px solid #3182ce; margin-bottom: 10px;">
        <strong style="display: block; margin-bottom: 8px;">🔔 Notification:</strong> 
        You have been shortlisted for one or more vacancies! Please proceed to take your CBT Exam.
        <ul style="margin-top: 10px; padding-left: 20px;">
          <% shortlistedApps.forEach(app => { %>
            <li style="margin-bottom: 5px;">
              <%= app.vacancy_title %> - 
              <a href="/exam/<%= app.vacancy_id %>" style="background-color: #3182ce; color: white; padding: 4px 10px; border-radius: 4px; text-decoration: none; font-size: 13px; font-weight: bold; margin-left: 8px;">Take CBT Exam</a>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <div class="card" style="border-top: 4px solid #38a169;">
      <h3 style="font-size:17px; margin-bottom:8px;">View Open Vacancies</h3>
      <p class="text-muted mb-2" style="font-size:14px;">Browse all active vacancies at Bayero University Kano and apply.</p>
      <a href="/vacancies" class="btn btn-primary">View Open Vacancies</a>
    </div>

    <div style="grid-column: 1 / -1; margin-top: 20px;">
      <h3 style="margin-bottom: 15px; color:#2d3748;">My Submissions</h3>
      <% if (myApplications && myApplications.length > 0) { %>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
            <thead>
              <tr style="background: #f7fafc; border-bottom: 1px solid #e2e8f0; text-align: left;">
                <th style="padding: 12px 16px; color:#4a5568;">Vacancy Title</th>
                <th style="padding: 12px 16px; color:#4a5568;">Application Date</th>
                <th style="padding: 12px 16px; color:#4a5568;">Status</th>
              </tr>
            </thead>
            <tbody>
              <% myApplications.forEach(app => { %>
                <tr style="border-bottom: 1px solid #e2e8f0;">
                  <td style="padding: 12px 16px;"><%= app.vacancy_title %></td>
                  <td style="padding: 12px 16px;"><%= new Date(app.applied_at).toLocaleDateString() %></td>
                  <td style="padding: 12px 16px;">
                    <% if (app.status === 'Pending') { %>
                      <span style="background: #edf2f7; color: #4a5568; padding: 4px 8px; border-radius: 12px; font-size: 12px; font-weight: bold;">Pending</span>
                    <% } else if (app.status === 'Shortlisted' || app.status === 'Recommended' || app.status === 'Accepted') { %>
                      <span style="background: #c6f6d5; color: #22543d; padding: 4px 8px; border-radius: 12px; font-size: 12px; font-weight: bold;"><%= app.status %></span>
                    <% } else if (app.status === 'Rejected') { %>
                      <span style="background: #fed7d7; color: #742a2a; padding: 4px 8px; border-radius: 12px; font-size: 12px; font-weight: bold;">Rejected</span>
                    <% } else { %>
                      <span style="background: #edf2f7; color: #4a5568; padding: 4px 8px; border-radius: 12px; font-size: 12px; font-weight: bold;"><%= app.status %></span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="color: #718096; background: white; padding: 20px; border-radius: 8px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">You have not submitted any applications yet.</p>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
