<%- include('partials/header', { pageTitle: 'Dashboard' }) %>

<div class="card">
  <h1 style="font-size:24px;color:#1a202c;margin-bottom:6px;">Welcome, <%= user.name %>!</h1>
  <p class="text-muted">Logged in as <strong><%= user.email %></strong>
    <span class="badge badge-info" style="text-transform:uppercase;"><%= user.role %></span></p>
</div>

<% if (user.role === 'admin' && analytics) { %>
  <% if (analytics.awaitingShortlist > 0) { %>
    <div class="alert alert-warn"><%= analytics.awaitingShortlist %> closed vacancy(ies) are awaiting shortlisting. It runs automatically within a minute, or run it from the vacancy's applicants page.</div>
  <% } %>
  <h2 style="font-size:18px;margin-bottom:14px;">System Overview</h2>
  <div class="grid grid-auto mb-3">
    <div class="card stat" style="border-color:#4299e1;margin:0"><h3>Applicant accounts</h3><p><%= analytics.totalUsers %></p></div>
    <div class="card stat" style="border-color:#48bb78;margin:0"><h3>Open vacancies</h3><p><%= analytics.totalVacancies %></p></div>
    <div class="card stat" style="border-color:#ecc94b;margin:0"><h3>Applications</h3><p><%= analytics.totalApplications %></p></div>
    <div class="card stat" style="border-color:#9f7aea;margin:0"><h3>Average exam score</h3><p><%= analytics.averageScore %>%</p></div>
  </div>

  <div class="grid grid-2 mb-3">
    <div class="card" style="margin:0"><h3 style="font-size:14px;color:#4a5568;margin-bottom:12px;">APPLICATION OUTCOMES (SHORTLISTING &amp; DECISIONS)</h3>
      <div style="max-width:300px;margin:0 auto"><canvas id="statusChart" aria-label="Application status chart" role="img"></canvas></div></div>
    <div class="card" style="margin:0"><h3 style="font-size:14px;color:#4a5568;margin-bottom:12px;">APPLICANT VOLUME PER VACANCY</h3>
      <canvas id="volumeChart" aria-label="Applications per vacancy chart" role="img"></canvas></div>
    <div class="card" style="margin:0"><h3 style="font-size:14px;color:#4a5568;margin-bottom:12px;">EXAM PASS RATE</h3>
      <% if (analytics.examOutcome.passed + analytics.examOutcome.failed === 0) { %>
        <p class="text-muted">No exams have been completed yet.</p>
      <% } else { %>
        <div style="max-width:300px;margin:0 auto"><canvas id="passChart" aria-label="Exam pass rate chart" role="img"></canvas></div>
      <% } %>
    </div>
  </div>

  <script src="/vendor/chart.js/chart.umd.js"></script>
  <script>
    (function () {
      if (typeof Chart === 'undefined') return;
      var status = <%- JSON.stringify(analytics.statusCounts) %>;
      var perVacancy = <%- JSON.stringify(analytics.perVacancy) %>;
      var exam = <%- JSON.stringify(analytics.examOutcome) %>;
      new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: { labels: Object.keys(status), datasets: [{ data: Object.values(status),
          backgroundColor: ['#a0aec0','#4299e1','#9f7aea','#68d391','#fc8181'] }] },
        options: { plugins: { legend: { position: 'bottom' } } }
      });
      new Chart(document.getElementById('volumeChart'), {
        type: 'bar',
        data: { labels: perVacancy.map(function (v) { return v.title.length > 22 ? v.title.slice(0, 20) + '…' : v.title; }),
          datasets: [{ label: 'Applications', data: perVacancy.map(function (v) { return v.apps; }), backgroundColor: '#4299e1' }] },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
      });
      var p = document.getElementById('passChart');
      if (p) new Chart(p, { type: 'doughnut',
        data: { labels: ['Passed', 'Failed'], datasets: [{ data: [exam.passed, exam.failed], backgroundColor: ['#68d391', '#fc8181'] }] },
        options: { plugins: { legend: { position: 'bottom' } } } });
    })();
  </script>

  <h2 style="font-size:18px;margin-bottom:14px;">Quick actions</h2>
  <div class="grid grid-auto">
    <div class="card" style="border-top:4px solid #2b6cb0;margin:0"><h3 style="font-size:17px;margin-bottom:8px;">Post a vacancy</h3>
      <p class="text-muted mb-2" style="font-size:14px;">Create a vacancy with requirements, opening date and deadline.</p>
      <a href="/vacancies/create" class="btn btn-primary">Post a New Vacancy</a></div>
    <div class="card" style="border-top:4px solid #2b6cb0;margin:0"><h3 style="font-size:17px;margin-bottom:8px;">Vacancies &amp; applicants</h3>
      <p class="text-muted mb-2" style="font-size:14px;">Review applicants, shortlist, schedule exams and manage the question bank.</p>
      <a href="/vacancies" class="btn btn-primary">Manage Vacancies</a></div>
    <div class="card" style="border-top:4px solid #805ad5;margin:0"><h3 style="font-size:17px;margin-bottom:8px;">Reports &amp; exports</h3>
      <p class="text-muted mb-2" style="font-size:14px;">Applicants, shortlist, merit lists and statistics as PDF or CSV.</p>
      <a href="/admin/reports" class="btn btn-primary" style="background:#553c9a">Open Reports</a></div>
  </div>

<% } else { %>
  <% const toExam = myApplications.filter(a => a.category === 'non-academic' && a.status === 'Shortlisted' && !a.exam_completed); %>
  <% if (toExam.length > 0) { %>
    <div class="alert alert-info"><strong>You have been shortlisted.</strong> Your computer-based test is waiting in
      <a href="/my-applications">My Applications</a>.</div>
  <% } %>

  <div class="grid grid-2">
    <div>
      <h2 style="font-size:18px;margin-bottom:14px;">Recent notifications</h2>
      <% if (notifications.length === 0) { %>
        <div class="empty">No notifications yet.</div>
      <% } else { %>
        <% notifications.forEach(n => { %>
          <div class="notice <%= n.is_read ? '' : 'notice-unread' %>">
            <%= n.message %><small><%= fmtDateTime(n.created_at) %></small>
          </div>
        <% }) %>
        <a href="/notifications">View all notifications &rarr;</a>
      <% } %>
    </div>
    <div>
      <h2 style="font-size:18px;margin-bottom:14px;">My submissions</h2>
      <% if (myApplications.length === 0) { %>
        <div class="empty">You have not applied for any vacancy yet.<br><a href="/vacancies">Browse open vacancies &rarr;</a></div>
      <% } else { %>
        <div class="table-wrap"><table>
          <thead><tr><th>Vacancy</th><th>Applied</th><th>Status</th></tr></thead>
          <tbody>
          <% myApplications.forEach(a => { %>
            <tr><td><%= a.vacancy_title %></td><td><%= fmtDate(a.applied_at) %></td>
              <td><span class="badge status-<%= a.status %>"><%= a.status %></span></td></tr>
          <% }) %>
          </tbody></table></div>
        <p class="mt-1"><a href="/my-applications">Track my applications in detail &rarr;</a></p>
      <% } %>
    </div>
  </div>
<% } %>
<%- include('partials/footer') %>
